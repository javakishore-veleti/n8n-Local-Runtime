      "name": "Discover Profile Files"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Input:\n *  stdout = newline-separated file paths\n *\n * Output:\n *  One item per file with metadata\n */\n\nconst stdout = $input.first().json.stdout || \"\";\n\nconst files = stdout\n  .split(\"\\n\")\n  .map(f => f.trim())\n  .filter(f => f.length > 0);\n\nreturn files.map(filePath => {\n  const ext = filePath.split(\".\").pop().toLowerCase();\n\n  let fileType = \"unknown\";\n  if (ext === \"md\") fileType = \"md\";\n  else if (ext === \"docx\") fileType = \"docx\";\n  else if (ext === \"xlsx\") fileType = \"xlsx\";\n\n  return {\n    json: {\n      file_path: filePath,\n      file_type: fileType,\n      category: filePath.split(\"/\").slice(-2, -1)[0]\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
